{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/RMYPG/edity/contracts/v1/schema",
  "$vocabulary": {
    "https://json-schema.org/draft/2020-12/vocab/core": true,
    "https://json-schema.org/draft/2020-12/vocab/applicator": true,
    "https://json-schema.org/draft/2020-12/vocab/unevaluated": true,
    "https://json-schema.org/draft/2020-12/vocab/validation": true,
    "https://json-schema.org/draft/2020-12/vocab/meta-data": true,
    "https://json-schema.org/draft/2020-12/vocab/format-annotation": true,
    "https://json-schema.org/draft/2020-12/vocab/content": true,
    "https://github.com/RMYPG/edity/contracts/v1/vocab/limits": true
  },
  "$dynamicAnchor": "meta",
  "title": "Edity dialect of JSON Schema 2020-12",
  "description": "JSON Schema 2020-12 plus Edity's Limits vocabulary. A page's JSON Schema, generated from its Field definitions, names this dialect in \"$schema\". The Limits vocabulary is required: a validator that does not implement it must refuse the schema.",
