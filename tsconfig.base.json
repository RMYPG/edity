{
  "compilerOptions": {
    "target": "es2024",
    "lib": ["es2024"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    // Inside the workspace, `@edity/*` imports resolve to each package's
    // `src/` through this export condition, so type-checking and tests need
    // no build. Builds turn it off and read the other packages' `dist/`.
    "customConditions": ["@edity/source"],
    "types": [],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  }
}
