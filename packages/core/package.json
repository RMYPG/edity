{
  "name": "@edity/core",
  "version": "0.1.0",
  "description": "Field definitions and Draft validation for Edity, the inline editor for Astro Sites.",
  "license": "MPL-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RMYPG/edity.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/RMYPG/edity/tree/main/packages/core#readme",
  "bugs": "https://github.com/RMYPG/edity/issues",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@edity/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test-d.ts"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "peerDependencies": {
    "zod": "^4.6.0"
  },
  "devDependencies": {
    "zod": "^4.6.7"
  },
  "publishConfig": {
    "access": "public"
  }
}
